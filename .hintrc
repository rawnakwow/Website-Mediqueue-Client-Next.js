  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter",
          "outline: 3px solid color-mix(in srgb,var(--accent) 70%,var(--brand))",
          "text-wrap",
          "border-color: color-mix(in srgb,var(--brand) 35%,var(--line))",
          "border-color: color-mix(in srgb,var(--brand) 36%,var(--line))",
          "mask-image"
        ]
      }
    ]
  }
}